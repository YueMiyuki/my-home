{
	"name": "my-home-next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"typecheck": "concurrently -n transpile,types -c cyan,magenta \"pnpm run typecheck:transpile\" \"tsgo -p tsconfig.json\" && rm -rf .swc",
		"typecheck:transpile": "swc app components hooks lib --out-dir .swc --ignore '**/*.d.ts' --ignore 'node_modules' --ignore '.next'",
		"start": "next start",
		"fmt": "pnpx @biomejs/biome format --write"
	},
	"dependencies": {
		"@carbon/icons-react": "^11.82.0",
		"@carbon/react": "^1.109.0",
		"geist": "^1.7.2",
		"next": "^16.2.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-is": "^19.2.7"
	},
	"devDependencies": {
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.43",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20260628.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"sass": "^1.100.0",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
